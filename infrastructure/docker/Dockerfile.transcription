FROM python:3.11-slim as base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PATH="/root/.local/bin:${PATH}"

WORKDIR /app

# System dependencies (ffmpeg for audio processing)
RUN apt-get update && \
    apt-get install -y --no-install-recommends ffmpeg git build-essential && \
    rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY requirements.txt /app/requirements.txt
RUN pip install --user -r requirements.txt

# Copy V2 application code
COPY core /app/core
COPY infrastructure/services/transcription /app/infrastructure/services/transcription
COPY modules/03-sales-conversation/transcript_analyzer /app/modules/03-sales-conversation/transcript_analyzer

# Copy main entry point
COPY infrastructure/services/transcription_main.py /app/main.py

# Ensure source tree is importable
ENV PYTHONPATH=/app

# Default runtime configuration
ENV WHISPER_MODEL_SIZE=tiny \
    WHISPER_DEVICE=cpu \
    WHISPER_COMPUTE_TYPE=int8 \
    PORT=8080

# Start with gunicorn
CMD exec gunicorn --bind :$PORT --workers 1 --timeout 3600 main:flask_app
