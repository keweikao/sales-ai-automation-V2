# Faster-Whisper Transcription Service
# 
# 使用 large-v3-turbo 模型 + pyannote 說話者辨識
# 預載模型到 image 中，加速冷啟動

FROM python:3.11-slim

# 安裝系統依賴
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 安裝 Python 依賴（先安裝依賴，利用 Docker cache）
COPY src/transcription/requirements.whisper.txt .
RUN pip install --no-cache-dir -r requirements.whisper.txt

# 預下載 Whisper 模型到 image（加速冷啟動）
# 這會增加 image 大小約 1.5GB，但冷啟動時不需要下載
RUN python -c "from faster_whisper import WhisperModel; \
    print('Downloading large-v3-turbo model...'); \
    WhisperModel('large-v3-turbo', device='cpu', compute_type='int8'); \
    print('Model downloaded successfully')"

# 複製應用程式碼
COPY src/ ./src

# 健康檢查端點
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

EXPOSE 8080
ENV PORT=8080
ENV TRANSCRIPTION_ENGINE=faster_whisper
ENV WHISPER_MODEL=large-v3-turbo
ENV ENABLE_DIARIZATION=false

# 使用 gunicorn 啟動
# - 單一 worker（避免記憶體競爭）
# - 3600 秒 timeout（支援 60 分鐘音檔）
# - 較大的 worker 超時
CMD ["gunicorn", \
    "--workers", "1", \
    "--bind", "0.0.0.0:8080", \
    "--timeout", "3600", \
    "--graceful-timeout", "300", \
    "--keep-alive", "5", \
    "src.transcription.main:flask_app"]
