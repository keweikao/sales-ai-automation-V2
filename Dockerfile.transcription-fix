# Dockerfile for transcription service - fix for local build context
FROM python:3.11-slim

# Install ffmpeg
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg

# Set the working directory
WORKDIR /app

# Copy requirements and install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the transcription module files
COPY . ./src/transcription

# Create __init__.py for src package
RUN mkdir -p /app/src && touch /app/src/__init__.py

# Make port 8080 available
EXPOSE 8080

# Define environment variable for the port
ENV PORT=8080

# Run the app
CMD ["gunicorn", "-w", "1", "-b", "0.0.0.0:8080", "--timeout", "3600", "src.transcription.main:flask_app"]
