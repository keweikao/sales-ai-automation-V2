{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "mcpServers": {
    "firestore": {
      "type": "stdio",
      "command": "python",
      "args": ["tools/firestore/mcp_server.py"],
      "description": "Query and manage Firestore collections",
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": "${GOOGLE_APPLICATION_CREDENTIALS}"
      }
    },
    "gcs": {
      "type": "stdio",
      "command": "python",
      "args": ["tools/gcs/mcp_server.py"],
      "description": "Google Cloud Storage operations",
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": "${GOOGLE_APPLICATION_CREDENTIALS}"
      }
    },
    "slack": {
      "type": "stdio",
      "command": "python",
      "args": ["tools/slack/mcp_server.py"],
      "description": "Slack API operations",
      "env": {
        "SLACK_BOT_TOKEN": "${SLACK_BOT_TOKEN}"
      }
    },
    "bigquery": {
      "type": "stdio",
      "command": "python",
      "args": ["tools/bigquery/mcp_server.py"],
      "description": "BigQuery data analysis",
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": "${GOOGLE_APPLICATION_CREDENTIALS}"
      }
    },
    "gcloud": {
      "type": "stdio",
      "command": "python",
      "args": ["tools/gcloud/mcp_server.py"],
      "description": "Google Cloud CLI operations"
    }
  },
  "permissions": {
    "allow": [
      "Bash(python tools/*)",
      "Bash(gcloud *)",
      "Skill"
    ]
  }
}
